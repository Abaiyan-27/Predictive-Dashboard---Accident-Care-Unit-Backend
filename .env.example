# Backend configuration template. Copy to .env (git-ignored) for local
# development, or set the same variables in your host's secret store.
# Every value below is a placeholder; the API refuses to start with them.
# Full reference: DEPLOYMENT.md.

# "development" (default) or "production". Production turns off /docs,
# /redoc and /openapi.json and requires exact https CORS origins.
APP_ENV=development
LOG_LEVEL=INFO

# SECRET — signs the API's session tokens (HMAC). At least 32 random
# characters, unique per environment. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Supabase project. SUPABASE_KEY is a SECRET: the service-role key
# (server-only, never in the frontend). Use https in production.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# Exact browser origins of the frontend, comma-separated, no trailing path.
# Production example: CORS_ORIGINS=https://<your-frontend-host>
CORS_ORIGINS=http://localhost:5173

# Optional: download the model bundle from a Hugging Face repository at
# startup (otherwise the bundle in app/ml_models is used). HF_TOKEN is a
# SECRET (read-only token). Pin HF_MODEL_REVISION to a commit hash so every
# start runs the same artifacts.
# HF_MODEL_REPO=<owner>/<repo>
# HF_MODEL_REVISION=<commit-hash>
# HF_TOKEN=<read-only-token>
# HF_MODEL_CACHE_DIR=/tmp/accident-care-models
